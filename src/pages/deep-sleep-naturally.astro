              <rect x="188" y="144" width="92" height="22" rx="6" fill="rgba(16, 217, 138, 0.2)" stroke="var(--nv-accent)" />
              <text x="234" y="160" text-anchor="middle" fill="var(--nv-text)" font-size="12" font-family="IBM Plex Mono, ui-monospace">deep</text>

