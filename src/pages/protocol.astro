---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Novrello Protocol | Novrello</title>
    <meta
      name="description"
      content="A practical protocol framework for improving sleep quality, recovery, and long-term cognitive performance."
    />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="protocol-page">
      <section class="intro">
        <p class="eyebrow">The Human Lab</p>
        <h1>Novrello Protocol</h1>
        <p>
          This page is the framework behind our articles: fix fundamentals first, test one lever at a time,
          and measure outcomes honestly. If you want the full evidence breakdowns, start in
          <a href="/articles">research articles</a>.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Novrello. All rights reserved.</p>
      <p class="disclaimer">
        Medical disclaimer: Content is educational only and is not a substitute for professional medical
        advice, diagnosis, or treatment.
      </p>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #080e12;
    color: #e7f0f2;
    font-family: 'IBM Plex Sans', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  .protocol-page {
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.8rem 0 3rem;
  }

  .intro {
    border: 1px solid rgba(16, 217, 138, 0.2);
    border-radius: 16px;
    padding: 1.1rem 1rem;
    background: rgba(16, 217, 138, 0.05);
  }

  .eyebrow {
    margin: 0;
    color: #10d98a;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0.5rem 0;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  p {
    margin: 0;
    color: rgba(231, 240, 242, 0.82);
    line-height: 1.75;
  }

  a {
    color: #10d98a;
  }

  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.3rem 0 2.6rem;
    border-top: 1px solid rgba(16, 217, 138, 0.18);
    color: rgba(231, 240, 242, 0.72);
    font-size: 0.93rem;
  }

  .site-footer p {
    margin: 0.32rem 0;
  }

  .disclaimer {
    max-width: 90ch;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.8rem;
  }
</style>

