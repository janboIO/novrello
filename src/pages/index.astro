---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Novrello | Optimize your biology</title>
    <meta
      name="description"
      content="Science-backed protocols for sleep, performance, and longevity. No fluff, just data."
    />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="home">
      <section class="hero">
        <p class="eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          The Human Lab
        </p>
        <h1>Optimize your <span class="accent">biology.</span></h1>
        <p class="hero-copy">
          Science-backed protocols for sleep, performance, and longevity. No fluff, just data.
        </p>
        <a class="cta" href="/sleep-hygiene-biohacking">Start with sleep &rarr;</a>
      </section>

      <section class="quiz reveal" aria-labelledby="sleep-quiz-title">
        <p class="quiz-eyebrow">Sleep Score Quiz</p>
        <h2 id="sleep-quiz-title">How Well Are You Actually Sleeping?</h2>
        <p class="quiz-subtitle">
          5 questions based on validated sleep research domains. Not a diagnosis — a starting point.
        </p>
        <p class="quiz-note">Inspired by the Pittsburgh Sleep Quality Index (Buysse et al., 1989)</p>

        <div class="quiz-progress-wrap" aria-live="polite">
          <div class="quiz-progress-head">
            <span id="quiz-step">Question 1 / 5</span>
            <span id="quiz-percent">20%</span>
          </div>
          <div class="quiz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="20">
            <div id="quiz-progress-fill" class="quiz-progress-fill"></div>
          </div>
        </div>

        <div id="quiz-card" class="quiz-card" aria-live="polite">
          <h3 id="quiz-question" class="quiz-question"></h3>
          <div id="quiz-answers" class="quiz-answers"></div>
          <button id="quiz-next" class="quiz-next" type="button" hidden>Next</button>
        </div>

        <div id="quiz-result" class="quiz-result" hidden>
          <p id="quiz-score" class="quiz-score"></p>
          <h3 id="quiz-result-title" class="quiz-result-title"></h3>
          <p id="quiz-result-copy" class="quiz-result-copy"></p>
          <p class="quiz-psqi-ref">
            A PSQI score above 5 has demonstrated 89.6% sensitivity and 86.5% specificity in distinguishing
            good from poor sleepers (Buysse et al., 1989). This quiz is for informational purposes only and
            is not a substitute for professional evaluation.
          </p>
          <a id="quiz-result-link" class="quiz-result-link" href="#">Read your recommended next step</a>
          <button id="quiz-restart" class="quiz-restart" type="button">Retake quiz</button>
        </div>
      </section>

      <section class="research">
        <h2>Latest research</h2>
        <div class="cards">
          <a class="card reveal" href="/magnesium-glycinate-sleep">
            <p class="card-tag">Sleep · Science</p>
            <h3>Magnesium Glycinate for Sleep</h3>
            <p>
              Does it actually work? We break down the mechanisms, the real studies, and the correct dosage.
            </p>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer reveal">
      <p>&copy; {new Date().getFullYear()} Novrello. All rights reserved.</p>
      <p class="disclaimer">
        Medical disclaimer: Content is educational only and is not a substitute for professional
        medical advice, diagnosis, or treatment.
      </p>
    </footer>
  </body>
</html>

<script>
  const quizQuestions = [
    {
      question: 'On average, how long does it take you to fall asleep after getting into bed?',
      answers: [
        { label: 'A) Less than 15 minutes', points: 0 },
        { label: 'B) 16–30 minutes', points: 1 },
        { label: 'C) 31–60 minutes', points: 2 },
        { label: 'D) More than 60 minutes', points: 3 },
      ],
    },
    {
      question: 'How many hours of actual sleep do you get per night?',
      answers: [
        { label: 'A) More than 7 hours', points: 0 },
        { label: 'B) 6–7 hours', points: 1 },
        { label: 'C) 5–6 hours', points: 2 },
        { label: 'D) Less than 5 hours', points: 3 },
      ],
    },
    {
      question: 'How often do you wake up during the night or early morning?',
      answers: [
        { label: 'A) Less than once a week', points: 0 },
        { label: 'B) Once or twice a week', points: 1 },
        { label: 'C) Three or more times a week', points: 2 },
        { label: 'D) Every night', points: 3 },
      ],
    },
    {
      question: 'How often do you have trouble staying awake during the day?',
      answers: [
        { label: 'A) Rarely or never', points: 0 },
        { label: 'B) Once or twice a week', points: 1 },
        { label: 'C) Three or more times a week', points: 2 },
        { label: 'D) Every day', points: 3 },
      ],
    },
    {
      question: 'Overall, how would you rate your sleep quality over the past month?',
      answers: [
        { label: 'A) Very good', points: 0 },
        { label: 'B) Fairly good', points: 1 },
        { label: 'C) Fairly bad', points: 2 },
        { label: 'D) Very bad', points: 3 },
      ],
    },
  ];

  const results = [
    {
      min: 0,
      max: 4,
      title: 'Good sleeper',
      copy: 'Your sleep quality is in a healthy range. Fine-tune with our advanced protocols.',
      href: '/deep-sleep-naturally',
    },
    {
      min: 5,
      max: 8,
      title: 'Borderline',
      copy: 'Mild sleep difficulties. Targeted interventions could meaningfully improve your quality of life.',
      href: '/sleep-hygiene-biohacking',
    },
    {
      min: 9,
      max: 15,
      title: 'Poor sleeper',
      copy: 'This score range is associated with significant sleep impairment in clinical research. The interventions that help most are simpler than you think.',
      href: '/magnesium-glycinate-sleep',
    },
  ];

  const stepEl = document.getElementById('quiz-step');
  const percentEl = document.getElementById('quiz-percent');
  const progressTrack = document.querySelector('.quiz-progress-track');
  const progressFill = document.getElementById('quiz-progress-fill');
  const quizCard = document.getElementById('quiz-card');
  const questionEl = document.getElementById('quiz-question');
  const answersEl = document.getElementById('quiz-answers');
  const nextBtn = document.getElementById('quiz-next');
  const resultEl = document.getElementById('quiz-result');
  const scoreEl = document.getElementById('quiz-score');
  const resultTitleEl = document.getElementById('quiz-result-title');
  const resultCopyEl = document.getElementById('quiz-result-copy');
  const resultLinkEl = document.getElementById('quiz-result-link');
  const restartBtn = document.getElementById('quiz-restart');

  let currentIndex = 0;
  let selectedPoints = null;
  let totalScore = 0;

  function updateProgress() {
    const percent = Math.round(((currentIndex + 1) / quizQuestions.length) * 100);
    stepEl.textContent = `Question ${currentIndex + 1} / ${quizQuestions.length}`;
    percentEl.textContent = `${percent}%`;
    progressFill.style.width = `${percent}%`;
    progressTrack.setAttribute('aria-valuenow', String(percent));
  }

  function animateCard(renderFn) {
    quizCard.classList.add('is-transitioning');
    window.setTimeout(() => {
      renderFn();
      quizCard.classList.remove('is-transitioning');
    }, 180);
  }

  function renderQuestion() {
    const q = quizQuestions[currentIndex];
    selectedPoints = null;
    nextBtn.hidden = true;
    questionEl.textContent = q.question;
    answersEl.innerHTML = '';

    q.answers.forEach((answer) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'quiz-answer';
      button.textContent = answer.label;
      button.addEventListener('click', () => {
        answersEl.querySelectorAll('.quiz-answer').forEach((el) => el.classList.remove('is-selected'));
        button.classList.add('is-selected');
        selectedPoints = answer.points;
        nextBtn.hidden = false;
      });
      answersEl.appendChild(button);
    });
  }

  function showResult() {
    const result = results.find((item) => totalScore >= item.min && totalScore <= item.max) || results[1];
    quizCard.hidden = true;
    document.querySelector('.quiz-progress-wrap').hidden = true;
    resultEl.hidden = false;
    scoreEl.textContent = `Your PSQI-inspired score: ${totalScore}/15`;
    resultTitleEl.textContent = result.title;
    resultCopyEl.textContent = result.copy;
    resultLinkEl.href = result.href;
  }

  nextBtn.addEventListener('click', () => {
    if (selectedPoints === null) return;
    totalScore += selectedPoints;
    if (currentIndex === quizQuestions.length - 1) {
      showResult();
      return;
    }
    currentIndex += 1;
    updateProgress();
    animateCard(renderQuestion);
  });

  restartBtn.addEventListener('click', () => {
    currentIndex = 0;
    selectedPoints = null;
    totalScore = 0;
    quizCard.hidden = false;
    document.querySelector('.quiz-progress-wrap').hidden = false;
    resultEl.hidden = true;
    updateProgress();
    animateCard(renderQuestion);
  });

  updateProgress();
  renderQuestion();
</script>

<style>
  :global(:root) {
    --nv-bg: #080e12;
    --nv-accent: #10d98a;
    --nv-text: #e7f0f2;
    --nv-muted: rgba(231, 240, 242, 0.72);
    --nv-surface: rgba(16, 217, 138, 0.06);
    --nv-stroke: rgba(16, 217, 138, 0.24);
  }

  :global(body) {
    background: var(--nv-bg);
    color: var(--nv-text);
    font-family: 'IBM Plex Sans', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  .home {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.25rem 0 2.5rem;
  }

  .hero {
    min-height: min(68vh, 740px);
    display: grid;
    align-content: center;
    gap: 1rem;
    animation: fade-up 700ms ease-out both;
  }

  .eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--nv-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.82rem;
  }

  .pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--nv-accent);
    box-shadow: 0 0 0 rgba(16, 217, 138, 0.75);
    animation: pulse 1.7s ease-out infinite;
  }

  h1 {
    margin: 0;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    max-width: 14ch;
  }

  .accent {
    color: var(--nv-accent);
  }

  .hero-copy {
    margin: 0.15rem 0 0;
    color: var(--nv-muted);
    font-size: clamp(1rem, 1.9vw, 1.25rem);
    line-height: 1.6;
    max-width: 62ch;
  }

  .cta {
    margin-top: 0.55rem;
    width: fit-content;
    text-decoration: none;
    color: #062015;
    background: var(--nv-accent);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.8rem 1.1rem;
    border: 1px solid transparent;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(16, 217, 138, 0.28);
  }

  .quiz {
    margin: 0.95rem 0 2rem;
    border: 1px solid rgba(16, 217, 138, 0.24);
    border-radius: 18px;
    padding: 1.1rem 1rem 1.25rem;
    background: linear-gradient(180deg, rgba(16, 217, 138, 0.08), rgba(16, 217, 138, 0.03));
  }

  .quiz-eyebrow {
    margin: 0;
    color: var(--nv-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.78rem;
  }

  .quiz-subtitle {
    margin: 0.2rem 0 0.32rem;
    color: var(--nv-muted);
    max-width: 74ch;
  }

  .quiz-note {
    margin: 0 0 1rem;
    color: rgba(231, 240, 242, 0.64);
    font-size: 0.85rem;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
  }

  .quiz-progress-wrap {
    margin-bottom: 1rem;
  }

  .quiz-progress-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
    color: var(--nv-muted);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.78rem;
  }

  .quiz-progress-track {
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background: rgba(231, 240, 242, 0.12);
    overflow: hidden;
  }

  .quiz-progress-fill {
    width: 20%;
    height: 100%;
    background: linear-gradient(90deg, #10d98a, #4cf0b0);
    transition: width 220ms ease;
  }

  .quiz-card {
    border: 1px solid rgba(231, 240, 242, 0.14);
    border-radius: 14px;
    padding: 0.95rem 0.9rem;
    background: rgba(8, 14, 18, 0.38);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .quiz-card.is-transitioning {
    opacity: 0;
    transform: translateY(8px);
  }

  .quiz-question {
    margin: 0 0 0.8rem;
  }

  .quiz-answers {
    display: grid;
    gap: 0.55rem;
  }

  .quiz-answer {
    text-align: left;
    border: 1px solid rgba(231, 240, 242, 0.16);
    background: rgba(8, 14, 18, 0.45);
    color: var(--nv-text);
    border-radius: 12px;
    padding: 0.72rem 0.75rem;
    font: inherit;
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .quiz-answer:hover {
    border-color: rgba(16, 217, 138, 0.4);
    transform: translateY(-1px);
  }

  .quiz-answer.is-selected {
    border-color: rgba(16, 217, 138, 0.62);
    background: rgba(16, 217, 138, 0.14);
    box-shadow: 0 0 0 1px rgba(16, 217, 138, 0.16) inset;
  }

  .quiz-next,
  .quiz-restart {
    margin-top: 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.62rem 0.95rem;
    font: inherit;
    font-weight: 600;
    color: #062015;
    background: var(--nv-accent);
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .quiz-next:hover,
  .quiz-restart:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(16, 217, 138, 0.26);
  }

  .quiz-result {
    border: 1px solid rgba(16, 217, 138, 0.35);
    border-radius: 14px;
    padding: 0.9rem;
    background: rgba(16, 217, 138, 0.08);
  }

  .quiz-score {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    color: var(--nv-accent);
    font-size: 0.8rem;
  }

  .quiz-result-title {
    margin: 0.3rem 0 0.45rem;
  }

  .quiz-result-copy {
    margin: 0;
    color: var(--nv-muted);
  }

  .quiz-psqi-ref {
    margin: 0.75rem 0 0;
    color: rgba(231, 240, 242, 0.7);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .quiz-result-link {
    display: inline-flex;
    margin-top: 0.8rem;
    color: var(--nv-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .research {
    padding: 1.25rem 0 2rem;
  }

  h2 {
    margin: 0 0 1.2rem;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.95rem;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(180deg, rgba(16, 217, 138, 0.08), rgba(16, 217, 138, 0.04));
    border: 1px solid var(--nv-stroke);
    border-radius: 16px;
    padding: 1.15rem 1rem 1rem;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 217, 138, 0.45);
    background: linear-gradient(180deg, rgba(16, 217, 138, 0.12), rgba(16, 217, 138, 0.06));
  }

  h3 {
    margin: 0 0 0.5rem;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: 1.35rem;
  }

  .card p {
    margin: 0;
    color: var(--nv-muted);
    line-height: 1.55;
  }

  .card-tag {
    margin: 0 0 0.4rem;
    color: var(--nv-accent);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.3rem 0 2.6rem;
    border-top: 1px solid rgba(16, 217, 138, 0.18);
    color: var(--nv-muted);
    font-size: 0.93rem;
  }

  .site-footer p {
    margin: 0.32rem 0;
  }

  .disclaimer {
    max-width: 90ch;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.8rem;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    animation: fade-up 600ms ease-out forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 36%;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 217, 138, 0.75);
    }
    70% {
      box-shadow: 0 0 0 14px rgba(16, 217, 138, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 217, 138, 0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .hero,
    .pulse-dot {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
