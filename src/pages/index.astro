---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Novrello | Optimize your biology</title>
    <meta
      name="description"
      content="Science-backed protocols for sleep, performance, and longevity. No fluff, just data."
    />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="home">
      <section class="hero">
        <p class="eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          The Human Lab
        </p>
        <h1>Optimize your <span class="accent">biology.</span></h1>
        <p class="hero-copy">
          Science-backed protocols for sleep, performance, and longevity. No fluff, just data.
        </p>
        <a class="cta" href="/best-sleep-trackers-2026">Start with sleep &rarr;</a>
      </section>

      <section class="research">
        <h2>Latest research</h2>
        <div class="cards">
          <a class="card reveal" href="/magnesium-glycinate-sleep">
            <p class="card-tag">Sleep · Science</p>
            <h3>Magnesium Glycinate for Sleep</h3>
            <p>
              Does it actually work? We break down the mechanisms, the real studies, and the correct dosage.
            </p>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer reveal">
      <p>&copy; {new Date().getFullYear()} Novrello. All rights reserved.</p>
      <p class="disclaimer">
        Medical disclaimer: Content is educational only and is not a substitute for professional
        medical advice, diagnosis, or treatment.
      </p>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --nv-bg: #080e12;
    --nv-accent: #10d98a;
    --nv-text: #e7f0f2;
    --nv-muted: rgba(231, 240, 242, 0.72);
    --nv-surface: rgba(16, 217, 138, 0.06);
    --nv-stroke: rgba(16, 217, 138, 0.24);
  }

  :global(body) {
    background: var(--nv-bg);
    color: var(--nv-text);
    font-family: 'IBM Plex Sans', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  .home {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.25rem 0 2.5rem;
  }

  .hero {
    min-height: min(68vh, 740px);
    display: grid;
    align-content: center;
    gap: 1rem;
    animation: fade-up 700ms ease-out both;
  }

  .eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--nv-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.82rem;
  }

  .pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--nv-accent);
    box-shadow: 0 0 0 rgba(16, 217, 138, 0.75);
    animation: pulse 1.7s ease-out infinite;
  }

  h1 {
    margin: 0;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    max-width: 14ch;
  }

  .accent {
    color: var(--nv-accent);
  }

  .hero-copy {
    margin: 0.15rem 0 0;
    color: var(--nv-muted);
    font-size: clamp(1rem, 1.9vw, 1.25rem);
    line-height: 1.6;
    max-width: 62ch;
  }

  .cta {
    margin-top: 0.55rem;
    width: fit-content;
    text-decoration: none;
    color: #062015;
    background: var(--nv-accent);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.8rem 1.1rem;
    border: 1px solid transparent;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(16, 217, 138, 0.28);
  }

  .research {
    padding: 1.25rem 0 2rem;
  }

  h2 {
    margin: 0 0 1.2rem;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.95rem;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(180deg, rgba(16, 217, 138, 0.08), rgba(16, 217, 138, 0.04));
    border: 1px solid var(--nv-stroke);
    border-radius: 16px;
    padding: 1.15rem 1rem 1rem;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 217, 138, 0.45);
    background: linear-gradient(180deg, rgba(16, 217, 138, 0.12), rgba(16, 217, 138, 0.06));
  }

  h3 {
    margin: 0 0 0.5rem;
    font-family: 'DM Serif Display', Georgia, 'Times New Roman', Times, serif;
    font-size: 1.35rem;
  }

  .card p {
    margin: 0;
    color: var(--nv-muted);
    line-height: 1.55;
  }

  .card-tag {
    margin: 0 0 0.4rem;
    color: var(--nv-accent);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.3rem 0 2.6rem;
    border-top: 1px solid rgba(16, 217, 138, 0.18);
    color: var(--nv-muted);
    font-size: 0.93rem;
  }

  .site-footer p {
    margin: 0.32rem 0;
  }

  .disclaimer {
    max-width: 90ch;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.8rem;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    animation: fade-up 600ms ease-out forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 36%;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 217, 138, 0.75);
    }
    70% {
      box-shadow: 0 0 0 14px rgba(16, 217, 138, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 217, 138, 0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .hero,
    .pulse-dot {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
