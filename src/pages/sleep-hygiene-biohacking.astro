const title = 'Sleep Hygiene for Biohackers: The Evidence Behind the Habits That Actually Work';
const description =
  'A skeptical, evidence-based guide to sleep hygiene for biohackers: temperature, light, caffeine, alcohol, exercise timing, and building a personal protocol that holds up in real life.';
const canonical = 'https://novrello.com/sleep-hygiene-biohacking';
const publishedDate = '2026-03-31';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: canonical,
  datePublished: publishedDate,
  dateModified: publishedDate,
  author: { '@type': 'Organization', name: 'Novrello' },
  publisher: { '@type': 'Organization', name: 'Novrello' },
  articleSection: [
    'Introduction',
    'Temperature',
    'Light',
    'Caffeine timing',
    'Alcohol and sleep architecture',
    'Exercise timing',
    'The bedroom environment',
    'Building your personal sleep protocol',
    'Conclusion',
    'FAQ',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What temperature should my bedroom be for optimal sleep?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most people sleep best in a cool room. A practical starting point is roughly 16–19°C (60–67°F), then adjust based on comfort, bedding, and whether you wake hot or cold. The goal is to support the natural drop in core body temperature around sleep onset.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does alcohol help you sleep?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Alcohol can shorten sleep onset for some people, but the data show it disrupts sleep architecture—especially later in the night—by increasing fragmentation and reducing or delaying REM sleep. “Fall asleep faster” is not the same as “sleep better.”',
      },
    },
    {
      '@type': 'Question',
      name: 'How long before bed should I stop drinking caffeine?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A controlled study found 400 mg caffeine taken 6 hours before bedtime still significantly disrupted sleep. A conservative rule is to stop caffeine at least 6–8 hours before bed, and earlier if you are sensitive or struggle with sleep onset.',
      },
    },
  ],
};
